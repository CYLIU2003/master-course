{
  "name": "ev-bus-research-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EV bus research desktop workspace",
  "author": "EV Bus Research",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "api:generate": "node scripts/uv-python.mjs scripts/export-openapi.py && openapi-typescript openapi.json -o src/generated/api.ts && prettier --write src/generated/api.ts",
    "format": "prettier --write src electron vite.config.ts",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke",
    "package": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "jp.research.evbus",
    "productName": "EV Bus Research",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
